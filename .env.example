# These are read from the process environment — nothing auto-loads a .env file.
# Apply them by exporting or prefixing the start command, e.g.:
#   HL_BASE_URL=https://api.hyperliquid-testnet.xyz pnpm --filter @cta/server start

# Hyperliquid API base (override for testnet: https://api.hyperliquid-testnet.xyz)
HL_BASE_URL=https://api.hyperliquid.xyz
# Server port
PORT=3001
# SQLite candle cache location (relative to apps/server)
CACHE_DB_PATH=data/cache.sqlite
