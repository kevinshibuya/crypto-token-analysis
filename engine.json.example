{
  "universeCap": 0,
  "timeframes": ["15m", "1h", "4h", "1d"],
  "confirmedMinConfidence": 65,
  "provisionalMinConfidence": 75,
  "sinks": { "telegram": true, "discord": true, "macos": true },
